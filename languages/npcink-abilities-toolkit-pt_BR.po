#: includes/Support/Cloud_Derivative_Artifact.php:684
msgid "All verified transfer checks must pass before local adoption."
msgstr ""
"Todas as verificações de transferência verificada devem passar antes da "
"adoção local."

#: includes/Support/Cloud_Derivative_Artifact.php:688
msgid "Verified transfer evidence has an invalid acknowledgement deadline."
msgstr ""
"A evidência de transferência verificada tem um prazo de reconhecimento "
"inválido."

#: includes/Support/Cloud_Derivative_Artifact.php:704
msgid "A Cloud delivery acknowledgement is required."
msgstr "Um reconhecimento de entrega do Cloud é obrigatório."

#: includes/Support/Cloud_Derivative_Artifact.php:706
msgid ""
"The Cloud delivery acknowledgement does not match the required contract."
msgstr ""
"O reconhecimento de entrega do Cloud não corresponde ao contrato exigido."

#: includes/Support/Cloud_Derivative_Artifact.php:711
msgid "The Cloud delivery acknowledgement posture is invalid."
msgstr "A postura do reconhecimento de entrega do Cloud é inválida."

#: includes/Support/Cloud_Derivative_Artifact.php:714
