msgid "Animated derivative transformation facts are not supported."
msgstr "Fatos de transformação de derivado animado não são suportados."

#: includes/Support/Cloud_Derivative_Artifact.php:579
msgid "Derivative transformation alpha facts must be boolean values."
msgstr ""
"Os fatos de alfa da transformação do derivado devem ser valores booleanos."

#: includes/Support/Cloud_Derivative_Artifact.php:585
msgid "Derivative transformation flags must be boolean values."
msgstr ""
"Os sinalizadores da transformação do derivado devem ser valores booleanos."

