msgstr "No tienes permiso para planificar borradores de artículos."

#: includes/Packages/Read_Traits/Article_Block_Plan_Read_Methods.php:38
msgid "Article block plans currently support post_type=post only."
msgstr ""
"Los planes de bloques de artículo actualmente solo admiten post_type=post."

#: includes/Packages/Read_Traits/Article_Block_Plan_Read_Methods.php:41
msgid "Article block plans currently support status=draft only."
msgstr ""
"Los planes de bloques de artículo actualmente solo admiten status=draft."

#: includes/Packages/Read_Traits/Article_Block_Plan_Read_Methods.php:44
