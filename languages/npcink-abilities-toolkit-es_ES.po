msgid "The Cloud Addon receive payload must be an object."
msgstr "La carga útil de recepción de Cloud Addon debe ser un objeto."

#: includes/Support/Cloud_Derivative_Artifact.php:325
msgid "The Cloud Addon receive payload does not match the required contract."
msgstr ""
"La carga útil de recepción de Cloud Addon no coincide con el contrato "
"requerido."

