msgid ""
"The derivative artifact MIME type is not supported for media replacement."
msgstr ""
"El tipo MIME del artefacto derivado no se admite para la sustitución de "
"medios."

#: includes/Support/Cloud_Derivative_Artifact.php:254
msgid "The derivative artifact format does not match its MIME type."
msgstr "El formato del artefacto derivado no coincide con su tipo MIME."

