msgid "The received derivative size did not match its declared facts."
msgstr ""
"El tamaño del derivado recibido no coincidió con sus datos declarados."

#: includes/Support/Cloud_Derivative_Artifact.php:363
msgid "The received derivative checksum did not match its bytes."
msgstr ""
"La suma de verificación del derivado recibido no coincidió con sus bytes."

